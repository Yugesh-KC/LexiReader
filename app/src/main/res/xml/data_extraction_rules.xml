<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+.
   Cloud backup keeps only the notes database and settings: imported books and covers are large
   (Auto Backup stops entirely past 25 MB) and can be re-imported. A device-to-device transfer has
   no such quota, so books come along too.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="reader.db" />
        <include domain="sharedpref" path="reader_settings.xml" />
        <exclude domain="file" path="books/" />
        <exclude domain="file" path="covers/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="reader.db" />
        <include domain="sharedpref" path="reader_settings.xml" />
        <include domain="file" path="books/" />
        <include domain="file" path="covers/" />
    </device-transfer>
</data-extraction-rules>
